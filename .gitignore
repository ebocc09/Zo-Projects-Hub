# The shared credential store lives outside the project, but never risk it.
.admin.json
credentials.json

node_modules/
*.log

# Each board keeps its own runtime state — settings, caches, and any cookie
# it fell back to before the hub existed. None of it belongs in a shared zip.
boards/*/.connections.json
boards/*/.connections.*.json
boards/*/.connections.bak*
boards/*/.garage.json
boards/*/.tokens*.json
boards/*/.client*.json
boards/*/.admin.json
boards/*/.trt-cache.json
boards/*/.staff-cache.json
boards/*/.measure-cache.json
boards/*/.vin-trt-cache.json

# Per-board server output from launches.
logs/

# What the updater keeps when an incoming file would overwrite a local edit.
.zo-backup/

# The fetched Node runtime. Never committed and never published: 92 MB of stock
# binary, in a public repo, against GitHub's 100 MiB hard limit on a blob. It
# arrives as a release asset instead — see release-runtime.js. The trailing
# slash matters; runtime.json is the pinned descriptor and MUST publish.
runtime/
